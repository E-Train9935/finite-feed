# -----------------------------------------------------------------------------
# FINITE_FEED production environment
# Copy to .env for local development. Zero-config local mode still works with
# guest sessions, public Reddit JSON (when reachable), deterministic fallback,
# and file-backed history.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=8080
APP_ID=finite-feed
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_SECRET=change-me-to-a-long-random-secret-before-production

# Storage: file | firestore
STORAGE_DRIVER=file
DATA_FILE=./apps/api/data/briefings.json

# Firebase Admin (required when STORAGE_DRIVER=firestore or strict Firebase auth)
# Prefer GOOGLE_APPLICATION_CREDENTIALS in cloud environments, or supply JSON.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase browser SDK public config. These are intentionally VITE_ variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Reddit official OAuth app credentials. If absent, local development attempts
# the public JSON endpoint, then falls back to bundled demo-source data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:finite_feed:v2.0 (by /u/your-reddit-username)
REDDIT_POST_LIMIT=15
ALLOW_PUBLIC_REDDIT_FALLBACK=true
ALLOW_DEMO_SOURCES=true

# Inference provider: ollama | openai-compatible | auto
AI_PROVIDER=auto
AI_TIMEOUT_MS=60000
AI_DEFAULT_MODEL=llama3.2:3b
AI_COMPARISON_MODEL=mistral:7b

# Ollama (local Docker/local machine or remote self-hosted Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODELS=llama3.2:3b,mistral:7b,phi3:mini

# OpenAI-compatible hosted provider. Example for Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=...
# AI_MODELS=llama-3.1-8b-instant,openai/gpt-oss-20b
AI_BASE_URL=
AI_API_KEY=
AI_MODELS=

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SYNTHESIS_RATE_LIMIT_MAX=10
MAX_SUBREDDITS=6
MAX_QUERY_LENGTH=500
